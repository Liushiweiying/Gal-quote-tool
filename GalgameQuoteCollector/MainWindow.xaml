<Window x:Class="GalgameQuoteCollector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GalgameQuoteCollector.ViewModels"
        xmlns:conv="clr-namespace:GalgameQuoteCollector.Converters"
        Title="Galgame 语录收藏"
        Width="960" Height="640"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="0 0 0 1" Padding="0 0 0 8" Margin="0 0 0 8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"
                             Padding="6,4"/>
                    <TextBlock Text="搜索语录内容或游戏名..."
                               Foreground="#AAA"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <TextBlock Grid.Column="1"
                           Visibility="{Binding OcrAvailable, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                           Foreground="Red" Margin="8 0" VerticalAlignment="Center">
                    ⚠ OCR 不可用
                </TextBlock>

                <ComboBox Grid.Column="2" SelectedIndex="{Binding SortMode}"
                          Width="80" Margin="4,0,0,0" VerticalAlignment="Center">
                    <ComboBoxItem Content="按时间"/>
                    <ComboBoxItem Content="按游戏名"/>
                </ComboBox>

                <ComboBox Grid.Column="3" ItemsSource="{Binding AvailableGroups}"
                          DisplayMemberPath="Name"
                          SelectedValue="{Binding SelectedGroupFilter}"
                          SelectedValuePath="Id"
                          Width="100" Margin="4,0,0,0" VerticalAlignment="Center"/>

                <Button Grid.Column="4" Content="导入" Command="{Binding ImportCommand}"
                        Padding="12,4" Margin="4,0,0,0"/>

                <Button Grid.Column="5" Content="导出分组" Command="{Binding ExportGroupCommand}"
                        Padding="12,4" Margin="4,0,0,0"/>

                <Button Grid.Column="6" Content="导出全部" Command="{Binding ExportCommand}"
                        Padding="12,4" Margin="4,0,0,0"/>

                <Button Grid.Column="7" Content="设置" Command="{Binding OpenSettingsCommand}"
                        Padding="12,4" Margin="4,0,0,0"/>

                <Button Grid.Column="8" Content="回想" Command="{Binding OpenSlideshowCommand}"
                        Padding="12,4" Margin="4,0,0,0"/>

                <ToggleButton Grid.Column="9" Content="置顶" IsChecked="{Binding IsTopmost}"
                              Padding="12,4" Margin="4,0,0,0"/>

                <Button Grid.Column="10" Content="统计" Command="{Binding ShowStatsCommand}"
                        Padding="12,4" Margin="4,0,0,0"/>

                <Button Grid.Column="11" Content="采集" Command="{Binding CaptureCommand}"
                        Padding="12,4" Margin="4,0,0,0"/>
            </Grid>
        </Border>

        <!-- Main Content: Quote List + Detail -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Quote List -->
            <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <ListBox ItemsSource="{Binding Quotes}"
                             SelectedItem="{Binding SelectedQuote}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             BorderThickness="0"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,4" Margin="2" BorderBrush="#F0F0F0" BorderThickness="0 0 0 1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Thumbnail -->
                                        <Border Grid.Column="0" Width="42" Height="32" CornerRadius="3"
                                                Background="#EEE" Margin="0,0,6,0" ClipToBounds="True">
                                            <Image Source="{Binding ScreenshotPath}" Stretch="UniformToFill"
                                                   MaxWidth="42" MaxHeight="32"/>
                                        </Border>

                                        <!-- Text -->
                                        <Grid Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="{Binding GameName}"
                                                       FontWeight="SemiBold" Foreground="#1976D2" FontSize="12"/>

                                            <TextBlock Grid.Row="1" Text="{Binding PreviewText}"
                                                       TextWrapping="Wrap" MaxHeight="36"
                                                       TextTrimming="WordEllipsis" Margin="0,1,0,0" FontSize="12"/>

                                            <TextBlock Grid.Row="2" Text="{Binding CapturedAtDisplay}"
                                                       FontSize="10" Foreground="#999" Margin="0,1,0,0"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="还没有语录，按 Ctrl+Win+Z 采集"
                               Visibility="{Binding Quotes.Count, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#AAA" FontSize="14"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" Margin="0" Background="Transparent"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch">
                <GridSplitter.Style>
                    <Style TargetType="GridSplitter">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1976D2"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </GridSplitter.Style>
            </GridSplitter>

            <!-- Right: Detail Panel -->
            <Border Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4"
                    Padding="12" Margin="4,0,0,0">
                <Grid>
                    <TextBlock Text="选择一条语录查看详情"
                               Visibility="{Binding SelectedQuote, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#AAA" FontSize="14"/>

                    <ScrollViewer Visibility="{Binding SelectedQuote, Converter={StaticResource BoolToVis}}"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="游戏" FontSize="12" Foreground="#888" Margin="0 0 0 2"/>
                            <TextBox Text="{Binding EditGameName, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="6,4" Margin="0 0 0 12"/>

                            <TextBlock Text="采集时间" FontSize="12" Foreground="#888" Margin="0 0 0 2"/>
                            <Grid Margin="0 0 0 12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <DatePicker Grid.Column="0" SelectedDate="{Binding EditCapturedAt}"
                                            Padding="4,2"/>
                                <TextBox Grid.Column="1" Text="{Binding EditCapturedAt, StringFormat={}{0:HH:mm:ss}}"
                                         Width="80" Padding="4,2" Margin="4,0,0,0"
                                         VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="语录内容" FontSize="12" Foreground="#888" Margin="0 0 0 2"/>
                            <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="80"
                                     FontSize="14"
                                     Padding="6,4"
                                     Margin="0 0 0 12"/>

                            <TextBlock Text="截图" FontSize="12" Foreground="#888" Margin="0 0 0 2"/>
                            <Border Background="#F0F0F0" CornerRadius="4" Padding="4" Margin="0 0 0 8"
                                    Cursor="Hand">
                                <Border.ToolTip>
                                    <TextBlock Text="点击打开原图"/>
                                </Border.ToolTip>
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding OpenScreenshotCommand}"/>
                                </Border.InputBindings>
                                <Image Source="{Binding SelectedQuote.ScreenshotPath}"
                                       MaxHeight="240"
                                       Stretch="Uniform"/>
                            </Border>

                            <TextBlock Text="标签" FontSize="12" Foreground="#888" Margin="0 0 0 4"/>
                            <WrapPanel Margin="0 0 0 8">
                                <ItemsControl ItemsSource="{Binding CurrentTags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Name}"
                                                    Margin="2" Padding="8,2"
                                                    FontSize="12"
                                                    Background="#E3F2FD" Foreground="#1976D2"
                                                    BorderThickness="1" BorderBrush="#90CAF9"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.RemoveTagFromQuoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </WrapPanel>

                            <Grid Margin="0 0 0 12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding NewTagText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="6,4" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1" Content="+ 添加标签" Command="{Binding AddTagCommand}"
                                        Padding="8,4" Margin="4,0,0,0"/>
                            </Grid>

                            <TextBlock Text="所属分组" FontSize="12" Foreground="#888" Margin="0 0 0 4"/>
                            <WrapPanel Margin="0 0 0 8">
                                <ItemsControl ItemsSource="{Binding CurrentGroups}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Name}"
                                                    Margin="2" Padding="8,2"
                                                    FontSize="12"
                                                    Background="#1B5E20" Foreground="#FFF"
                                                    BorderThickness="1" BorderBrush="#388E3C"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.ToggleQuoteGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="删除分组"
                                                                  Command="{Binding DataContext.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Quick toggle all groups -->
                                <ItemsControl ItemsSource="{Binding AvailableGroups}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Name}"
                                                    Margin="2" Padding="8,2"
                                                    FontSize="12"
                                                    Background="#F5F5F5" Foreground="#888"
                                                    BorderThickness="1" BorderBrush="#CCC"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.ToggleQuoteGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="删除分组"
                                                                  Command="{Binding DataContext.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </WrapPanel>

                            <Grid Margin="0 0 0 8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding NewGroupText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="6,4" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1" Content="创建分组" Command="{Binding AddGroupCommand}"
                                        Padding="8,4" Margin="4,0,0,0"/>
                            </Grid>

                            <TextBlock Text="备注" FontSize="12" Foreground="#888" Margin="0 0 0 2"/>
                            <TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="60"
                                     Padding="6,4" Margin="0 0 0 12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="打开截图" Command="{Binding OpenScreenshotCommand}"
                                        Padding="8,4"/>

                                <Button Grid.Column="1" Content="导出" Command="{Binding ExportSelectedCommand}"
                                        Padding="12,4" Margin="4,0,0,0"/>

                                <Button Grid.Column="3" Content="保存修改" Command="{Binding SaveEditCommand}"
                                        Padding="12,4" Margin="4,0"
                                        Background="#1976D2" Foreground="White" BorderThickness="0"/>

                                <Button Grid.Column="4" Content="删除" Command="{Binding DeleteQuoteCommand}"
                                        Padding="12,4"
                                        Background="#E53935" Foreground="White" BorderThickness="0"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="0 1 0 0" Padding="0 6 0 0" Margin="0 8 0 0">
            <TextBlock Text="{Binding StatusText}" Foreground="#666" FontSize="12"/>
        </Border>
    </Grid>
</Window>
