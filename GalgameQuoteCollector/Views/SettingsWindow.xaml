<Window x:Class="GalgameQuoteCollector.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="440" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        ShowInTaskbar="False"
        Background="#FFF"
        PreviewKeyDown="Window_PreviewKeyDown">
    <ScrollViewer>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="快捷键" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 8"/>
            <TextBlock Grid.Row="1" Text="在此窗口打开时，直接按下你想用的快捷键组合"
                       Foreground="#666" FontSize="12" Margin="0 0 0 6"/>
            <Border Grid.Row="2" x:Name="HotkeyBox"
                    BorderBrush="#1976D2" BorderThickness="2" CornerRadius="4"
                    Background="#E3F2FD" Height="36" Padding="8,0"
                    MouseDown="HotkeyBox_MouseDown" Cursor="Hand">
                <TextBlock x:Name="HotkeyDisplay" Text="按键即捕获..."
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           FontSize="15" FontWeight="Bold" Foreground="#1976D2"/>
            </Border>
            <TextBlock Grid.Row="3" x:Name="CurrentHotkeyText" Foreground="#888" FontSize="12" Margin="0 6 0 0"/>

            <Separator Grid.Row="4" Margin="0,10,0,6"/>

            <StackPanel Grid.Row="5" Margin="0,0,0,6">
                <CheckBox x:Name="AutoStartCheckBox" Content="开机时自动启动（最小化到任务栏）" FontSize="13"/>
            </StackPanel>

            <StackPanel Grid.Row="6" Margin="0,0,0,6">
                <TextBlock Text="采集延迟" FontSize="13" Margin="0,0,0,2"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" x:Name="DelaySlider" Minimum="0" Maximum="2000"
                            TickFrequency="100" IsSnapToTickEnabled="True"
                            ValueChanged="DelaySlider_ValueChanged" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" x:Name="DelayLabel" Text="200ms" VerticalAlignment="Center" Width="60"/>
                </Grid>
            </StackPanel>

            <Separator Grid.Row="7" Margin="0,6,0,6"/>

            <!-- Game Name Rules -->
            <TextBlock Grid.Row="8" Text="游戏名匹配规则" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock Grid.Row="9" Text="窗口标题包含关键词时，自动映射到指定游戏名。优先于自动检测。"
                       Foreground="#666" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"/>

            <StackPanel Grid.Row="10">
                <!-- Existing rules -->
                <ItemsControl x:Name="RulesList" Margin="0,0,0,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="6,4" Margin="0,2" BorderBrush="#EEE" BorderThickness="0 0 0 1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Match}" FontWeight="Bold" Margin="0,0,4,0"/>
                                    <TextBlock Grid.Column="1" Text="→" Foreground="#999" Margin="0,0,4,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="#1976D2"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Add new rule -->
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Row="0" Grid.Column="0" x:Name="RuleMatchBox"
                             Padding="6,4" Margin="0,0,4,4" VerticalContentAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="RuleNameBox"
                             Padding="6,4" Margin="0,0,0,4" VerticalContentAlignment="Center" Width="160"/>
                    <Button Grid.Row="1" Grid.Column="0" Content="添加规则"
                            Click="OnAddRule" Padding="8,4" Margin="0,0,4,0"/>
                    <Button Grid.Row="1" Grid.Column="1" Content="删除选中"
                            Click="OnRemoveRule" Padding="8,4"/>
                </Grid>
            </StackPanel>

            <StackPanel Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SaveButton" Content="保存" IsEnabled="False"
                        Padding="16,6" Margin="0,0,8,0"
                        Click="OnSaveClick"
                        Background="#1976D2" Foreground="White" BorderThickness="0"/>
                <Button Content="取消" Padding="16,6"
                        Click="OnCancelClick"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
