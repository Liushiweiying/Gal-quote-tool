<Window x:Class="GalgameQuoteCollector.Views.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="统计"
        Width="520" Height="560"
        MinHeight="350"
        WindowStartupLocation="CenterOwner"
        Background="#FFF"
        ResizeMode="CanResize">
    <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Overview -->
            <TextBlock Text="概览" FontSize="18" FontWeight="SemiBold" Margin="0 0 0 12"/>
            <Grid Margin="0 0 0 16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock x:Name="TotalQuotesText" FontSize="28" FontWeight="Bold" Foreground="#1976D2" HorizontalAlignment="Center"/>
                    <TextBlock Text="语录" FontSize="12" Foreground="#888" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock x:Name="TotalGamesText" FontSize="28" FontWeight="Bold" Foreground="#388E3C" HorizontalAlignment="Center"/>
                    <TextBlock Text="游戏" FontSize="12" Foreground="#888" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock x:Name="TotalTagsText" FontSize="28" FontWeight="Bold" Foreground="#F57C00" HorizontalAlignment="Center"/>
                    <TextBlock Text="标签" FontSize="12" Foreground="#888" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock x:Name="TotalGroupsText" FontSize="28" FontWeight="Bold" Foreground="#7B1FA2" HorizontalAlignment="Center"/>
                    <TextBlock Text="分组" FontSize="12" Foreground="#888" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Separator Margin="0 0 0 12"/>

            <!-- By Game -->
            <TextBlock Text="按游戏" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 8"/>
            <ItemsControl x:Name="GameStatsList" Margin="0 0 0 16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0 2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#1976D2"/>
                            <TextBlock Grid.Column="1" Text="{Binding Count}" Foreground="#666" Margin="8,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Separator Margin="0 0 0 12"/>

            <!-- By Group -->
            <TextBlock Text="按分组" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 8"/>
            <ItemsControl x:Name="GroupStatsList" Margin="0 0 0 16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0 2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#7B1FA2"/>
                            <TextBlock Grid.Column="1" Text="{Binding Count}" Foreground="#666" Margin="8,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Separator Margin="0 0 0 12"/>

            <!-- By Tag -->
            <TextBlock Text="按标签" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 8"/>
            <ItemsControl x:Name="TagStatsList" Margin="0 0 0 16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0 2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#F57C00"/>
                            <TextBlock Grid.Column="1" Text="{Binding Count}" Foreground="#666" Margin="8,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Separator Margin="0 0 0 12"/>

            <!-- By Time -->
            <Grid Margin="0 0 0 8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="按时间" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <RadioButton x:Name="MonthlyRadio" Content="月度" IsChecked="True"
                                 Checked="OnTimeModeChanged" Margin="0,0,8,0"/>
                    <RadioButton x:Name="YearlyRadio" Content="年度"
                                 Checked="OnTimeModeChanged"/>
                </StackPanel>
            </Grid>
            <ItemsControl x:Name="TimeStatsList" Margin="0 0 0 8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0 2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Period}" Foreground="#E65100"/>
                            <TextBlock Grid.Column="1" Text="{Binding Count}" Foreground="#666" Margin="8,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Close -->
            <Button Content="关闭" Click="OnClose" Padding="16,6" HorizontalAlignment="Right" Margin="0 8 0 0"/>
        </StackPanel>
    </ScrollViewer>
</Window>
