<Window x:Class="GalgameQuoteCollector.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="320" Height="80"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Focusable="False"
        MouseDown="OnToastClick">
    <Border Background="#2D2D2D" CornerRadius="8" BorderBrush="#555" BorderThickness="1">
        <Grid Margin="10,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" x:Name="TitleText" FontSize="12" Foreground="#AAA"
                       TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="1" x:Name="BodyText" FontSize="14" Foreground="White"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36"/>
        </Grid>
    </Border>
</Window>
