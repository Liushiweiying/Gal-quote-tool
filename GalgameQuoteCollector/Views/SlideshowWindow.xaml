<Window x:Class="GalgameQuoteCollector.Views.SlideshowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="回想"
        Width="900" Height="650"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A2E"
        Foreground="#EEE"
        WindowStyle="None"
        ResizeMode="CanResize"
        PreviewKeyDown="OnKeyDown"
        MouseDown="OnWindowMouseDown">

    <Grid>
        <!-- ===== Normal Mode Layout ===== -->
        <Grid x:Name="NormalLayout">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Border Grid.Row="0" Background="#16213E" Padding="8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="← 关闭" x:Name="PrevOrCloseBtn"
                            Click="OnPrevOrClose" Padding="10,4" FontSize="13"
                            Background="#0F3460" Foreground="#EEE" BorderThickness="0"
                            Cursor="Hand"/>

                    <Button Grid.Column="1" Content="全屏" x:Name="FullscreenBtn"
                            Click="OnToggleFullscreen" Padding="8,4" FontSize="12" Margin="4,0,0,0"
                            Background="#0F3460" Foreground="#EEE" BorderThickness="0"
                            Cursor="Hand"/>

                    <Button Grid.Column="2" Content="置顶" x:Name="TopmostBtn"
                            Click="OnToggleTopmost" Padding="8,4" FontSize="12" Margin="4,0,0,0"
                            Background="#0F3460" Foreground="#EEE" BorderThickness="0"
                            Cursor="Hand"/>

                    <TextBlock Grid.Column="3" x:Name="GameNameText"
                               FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <Button Grid.Column="4" Content="关闭 →" x:Name="NextOrCloseBtn"
                            Click="OnNextOrClose" Padding="10,4" FontSize="13"
                            Background="#0F3460" Foreground="#EEE" BorderThickness="0"
                            Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Main content -->
            <Border Grid.Row="1" Padding="40,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" x:Name="ScreenshotBox"
                            Background="#0F3460" CornerRadius="8"
                            HorizontalAlignment="Center" MaxWidth="800" MaxHeight="380"
                            Margin="0,0,0,12">
                        <Image x:Name="ScreenshotImage" Stretch="Uniform" MaxWidth="800" MaxHeight="380"/>
                    </Border>

                    <Border Grid.Row="1" Background="#16213E" CornerRadius="8"
                            Padding="20,12" Margin="0,0,0,8" HorizontalAlignment="Center">
                        <TextBlock x:Name="QuoteText" TextWrapping="Wrap" FontSize="20" LineHeight="32"
                                   TextAlignment="Center" Foreground="#EEE" MaxWidth="700"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Bottom Bar -->
            <Border Grid.Row="2" Background="#16213E" Padding="12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="TagsText" FontSize="13" Foreground="#AAA" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" x:Name="ProgressText" FontSize="13" Foreground="#888" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== Fullscreen Mode Layout ===== -->
        <Grid x:Name="FullscreenLayout" Visibility="Collapsed" Background="Black">
            <Image x:Name="FsScreenshotImage" Stretch="Uniform"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Bottom overlay with game name + user's notes -->
            <Border x:Name="FsOverlay" VerticalAlignment="Bottom" Background="#80000000" Padding="24,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="FsGameNameText" FontSize="14" Foreground="#AAA" TextAlignment="Center"/>
                    <TextBlock Grid.Row="1" x:Name="FsNotesText" FontSize="20" LineHeight="30"
                               TextWrapping="Wrap" TextAlignment="Center" Foreground="White" Margin="0,6,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
