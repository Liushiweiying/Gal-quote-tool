<Window x:Class="GalQuoteCollector.Views.SlideshowSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="回想设置"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#F5F5F7" FontFamily="Segoe UI">
    <StackPanel Margin="20">
        <TextBlock Text="回想设置" FontSize="16" FontWeight="SemiBold" Foreground="#1D1D1F" Margin="0,0,0,12"/>

        <TextBlock Text="黑边处理（只影响显示，不改文件）" FontSize="12" Foreground="#888" Margin="0,0,0,4"/>
        <ComboBox x:Name="BarsCombo" FontSize="13" Padding="6,4" Margin="0,0,0,12">
            <ComboBoxItem Content="原样显示"/>
            <ComboBoxItem Content="裁掉黑边"/>
            <ComboBoxItem Content="黑边涂白"/>
        </ComboBox>

        <TextBlock Text="文字底样式" FontSize="12" Foreground="#888" Margin="0,0,0,4"/>
        <ComboBox x:Name="TextStyleCombo" FontSize="13" Padding="6,4" Margin="0,0,0,10">
            <ComboBoxItem Content="黑底白字（默认）"/>
            <ComboBoxItem Content="白底黑字"/>
        </ComboBox>

        <TextBlock Text="文字底透明度" FontSize="12" Foreground="#888" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Slider Grid.Column="0" x:Name="OpacitySlider" Minimum="0" Maximum="100" TickFrequency="5"
                    IsSnapToTickEnabled="True" ValueChanged="OnOpacityChanged" Margin="0,0,10,0"/>
            <TextBlock Grid.Column="1" x:Name="OpacityLabel" Text="50%" Width="44" FontSize="12"
                       Foreground="#5B6ABF" VerticalAlignment="Center"/>
        </Grid>

        <CheckBox x:Name="LoopCheck" Content="看完最后一张后循环" FontSize="13" Foreground="#333" Margin="0,0,0,12"/>

        <TextBlock Text="中文字体" FontSize="12" Foreground="#888" Margin="0,0,0,4"/>
        <TextBox x:Name="ChineseFontBox" FontSize="13" Padding="6,4" Margin="0,0,0,10"
                 Background="White" BorderBrush="#DDD"/>
        <TextBlock Text="英文字体" FontSize="12" Foreground="#888" Margin="0,0,0,4"/>
        <TextBox x:Name="EnglishFontBox" FontSize="13" Padding="6,4" Margin="0,0,0,12"
                 Background="White" BorderBrush="#DDD"/>

        <CheckBox x:Name="MagpieCheck" Content="全屏时用 Magpie 超分" FontSize="13" Foreground="#333" Margin="0,0,0,6"/>
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="超分热键" FontSize="12" Foreground="#888"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="MagpieHotkeyBox" FontSize="13" Padding="6,4"
                     Background="White" BorderBrush="#DDD"/>
        </Grid>
        <TextBlock Text="（留空 = 自动读取 Magpie 配置里的热键）" FontSize="11" Foreground="#BBB" Margin="0,0,0,14"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Click="OnCancel" Padding="18,7" Margin="0,0,8,0"
                    Background="#EEE" Foreground="#333" BorderThickness="0" FontSize="13" Cursor="Hand"/>
            <Button Content="应用" Click="OnOk" Padding="18,7"
                    Background="#5B6ABF" Foreground="White" BorderThickness="0" FontSize="13" Cursor="Hand"/>
        </StackPanel>
    </StackPanel>
</Window>
