<Window x:Class="GalQuoteCollector.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="660" Height="700" MinWidth="560" MinHeight="440"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F5F7"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#3C3C43"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF0FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="132"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧分类导航：点了跳到对应分组 -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E5E5EA" BorderThickness="0,0,1,0">
            <StackPanel Margin="10,20,10,10">
                <TextBlock Text="分类" FontSize="11" Foreground="#999" Margin="6,0,0,8"/>
                <Button Content="快捷键" Click="OnJumpHotkey" Style="{StaticResource NavButton}"/>
                <Button Content="常规" Click="OnJumpGeneral" Style="{StaticResource NavButton}"/>
                <Button Content="回想" Click="OnJumpSlideshow" Style="{StaticResource NavButton}"/>
                <Button Content="超分（Magpie）" Click="OnJumpMagpie" Style="{StaticResource NavButton}"/>
                <Button Content="截图与黑边" Click="OnJumpCapture" Style="{StaticResource NavButton}"/>
                <Button Content="数据与备份" Click="OnJumpBackup" Style="{StaticResource NavButton}"/>
                <Button Content="网页与手机" Click="OnJumpWeb" Style="{StaticResource NavButton}"/>
                <Button Content="OCR 识别" Click="OnJumpOcr" Style="{StaticResource NavButton}"/>
                <Button Content="游戏名规则" Click="OnJumpRules" Style="{StaticResource NavButton}"/>
                <TextBlock Text="（点击可跳到对应分类）" FontSize="10" Foreground="#BBB"
                           Margin="6,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" x:Name="SettingsScroll" Padding="26,22,26,32">
        <StackPanel x:Name="SettingsRoot">

            <!-- ═══ Hotkey ═══ -->
            <TextBlock x:Name="SecHeaderHotkey" Text="快捷键" FontSize="16" FontWeight="SemiBold" Foreground="#1D1D1F" Margin="0,0,0,6"/>
            <TextBlock Text="在此窗口打开时，直接按下你想用的快捷键组合"
                       Foreground="#888" FontSize="12" Margin="0,0,0,10"/>
            <Border x:Name="HotkeyBox"
                    BorderBrush="#5B6ABF" BorderThickness="2"
                    Background="#EEF0FF" Height="38" Padding="12,0"
                    CornerRadius="8"
                    MouseDown="HotkeyBox_MouseDown" Cursor="Hand">
                <TextBlock x:Name="HotkeyDisplay" Text="按键即捕获..."
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           FontSize="15" FontWeight="Bold" Foreground="#5B6ABF"/>
            </Border>
            <TextBlock x:Name="CurrentHotkeyText" Foreground="#888" FontSize="12" Margin="0,8,0,0"/>

            <TextBlock Text="补拍（为当前语录追加截图）" FontSize="13" Foreground="#555" Margin="0,12,0,4"/>
            <Border x:Name="AddShotBox"
                    BorderBrush="#5B6ABF" BorderThickness="2"
                    Background="#EEF0FF" Height="38" Padding="12,0"
                    CornerRadius="8"
                    MouseDown="AddShotBox_MouseDown" Cursor="Hand">
                <TextBlock x:Name="AddShotDisplay" Text="按键即捕获..."
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           FontSize="15" FontWeight="Bold" Foreground="#5B6ABF"/>
            </Border>
            <TextBlock x:Name="CurrentAddShotText" Foreground="#888" FontSize="12" Margin="0,8,0,0"/>

            <Separator Margin="0,18,0,16"/>

            <!-- ═══ General ═══ -->
            <Border Height="1" Background="#E5E5EA" Margin="0,22,0,0"/><TextBlock x:Name="SecHeaderGeneral" Text="常规" FontSize="16" FontWeight="SemiBold" Foreground="#1D1D1F" Margin="0,16,0,12"/>

            <CheckBox x:Name="AutoStartCheckBox" Content="开机时自动启动（最小化到任务栏）"
                      FontSize="13" Foreground="#333" Margin="0,0,0,10"/>

            <CheckBox x:Name="SwallowHotkeyCheckBox"
                      Content="截图热键不再传给游戏（避免撞键，如引擎自带的 Alt+E）"
                      FontSize="13" Foreground="#333" Margin="0,0,0,4"
                      ToolTip="开启后：按截图热键时这个键不会传到游戏里，游戏引擎自己的同名热键（例如 Alt+E）就不会被触发。
关掉后：按键照常传给游戏，可能与游戏功能同时触发。
在本程序自己的窗口里永远不拦截。"/>
            <TextBlock Text="如果你确实需要游戏里的这个键，就关掉它，或者把截图热键换成不冲突的组合（如 Ctrl+Alt+E）"
                       Foreground="#BBB" FontSize="11" Margin="0,0,0,14" TextWrapping="Wrap"/>

            <Border Height="1" Background="#E5E5EA" Margin="0,22,0,0"/><TextBlock x:Name="SecHeaderSlideshow" Text="回想" FontSize="16" FontWeight="SemiBold" Foreground="#1D1D1F" Margin="0,16,0,12"/>
            <TextBlock Text="回想模式" FontSize="13" Foreground="#555" Margin="0,0,0,4"/>
            <ComboBox x:Name="SlideshowModeCombo" FontSize="13" Margin="0,0,0,4"
                      Background="White" BorderBrush="#DDD">
                <ComboBoxItem Content="按时间顺序"/>
                <ComboBoxItem Content="随机顺序"/>
            </ComboBox>
            <CheckBox x:Name="SlideshowLoopCheckBox" Content="循环播放（到末尾自动回到开头）"
                      FontSize="13" Foreground="#333" Margin="0,0,0,6"/>

            <TextBlock Text="回想中文字体" FontSize="13" Foreground="#555" Margin="0,0,0,4"/>
            <ComboBox x:Name="SlideshowChineseFontCombo" FontSize="13" Margin="0,0,0,4"
                      Background="White" BorderBrush="#DDD"
                      DisplayMemberPath="Source"/>
            <TextBlock Text="回想英文字体" FontSize="13" Foreground="#555" Margin="0,0,0,4"/>
            <ComboBox x:Name="SlideshowEnglishFontCombo" FontSize="13" Margin="0,0,0,6"
                      Background="White" BorderBrush="#DDD"
                      DisplayMemberPath="Source"/>

            <!-- ═══ Magpie 超分（回想全屏） ═══ -->
            <Border Height="1" Background="#E5E5EA" Margin="0,22,0,0"/><TextBlock x:Name="SecHeaderMagpie" Text="超分（Magpie）" FontSize="16" FontWeight="SemiBold" Foreground="#1D1D1F" Margin="0,16,0,12"/>
            <CheckBox x:Name="MagpieSlideshowCheckBox"
                      Content="全屏回想（F11）时用 Magpie 超分"
                      FontSize="13" Foreground="#333" Margin="0,0,0,4"
                      ToolTip="在回想窗口里按 F11 进入全屏后，自动发送 Magpie 的「缩放窗口」热键，由 Magpie 接管并超分这个全屏窗口；退出全屏或关闭回想时自动解除"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="MagpieHotkeyBox" FontSize="12" Padding="6,4"
                         VerticalContentAlignment="Center" Background="#F5F5F5" BorderBrush="#E0E0E0"
                         ToolTip="Magpie「缩放窗口」热键，如 Alt+Shift+A；留空则自动读取 Magpie 配置"/>
                <Button Grid.Column="1" Content="读取 Magpie 配置" Click="OnReadMagpieHotkey"
                        Padding="8,4" Margin="4,0,0,0" FontSize="12"/>
                <Button Grid.Column="2" Content="测试" Click="OnTestMagpieHotkey"
                        Padding="8,4" Margin="4,0,0,0" FontSize="12"/>
            </Grid>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="MagpiePathBox" FontSize="12" Padding="6,4"
                         VerticalContentAlignment="Center" Background="#F5F5F5" BorderBrush="#E0E0E0"
                         ToolTip="Magpie.exe 路径，留空则自动探测"/>
                <Button Grid.Column="1" Content="浏览..." Click="OnBrowseMagpiePath"
                        Padding="8,4" Margin="4,0,0,0" FontSize="12"/>
            </Grid>
            <TextBlock x:Name="MagpieStatusText"
                       Text="热键留空自动读取 Magpie 配置；点「测试」可验证热键是否真的触发 Magpie（全屏回想按 F11 后生效）"
                       Foreground="#BBB" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"/>

            <TextBlock Text="界面字体" FontSize="13" Foreground="#555" Margin="0,0,0,4"/>
            <ComboBox x:Name="FontCombo" FontSize="13" Margin="0,0,0,6"
                      Background="White" BorderBrush="#DDD"
                      DisplayMemberPath="Source"/>
            <TextBlock Text="需重启后生效" Foreground="#BBB" FontSize="11" Margin="0,-4,0,6"/>

            <CheckBox x:Name="EnableTrackingCheckBox" Content="启用使用时长记录"
                      FontSize="13" Foreground="#333" Margin="0,0,0,6"/>

            <CheckBox x:Name="HideUnrecognizedCheckBox" Content="搜索结果排除「[未识别到文字]」"
                      FontSize="13" Foreground="#333" Margin="0,0,0,6"/>

            <CheckBox x:Name="TranslucentTbFixCheckBox"
                      Content="TranslucentTB修复：开机自动重启一次 TranslucentTB，修复任务栏透明偶尔失效"
                      FontSize="13" Foreground="#333" Margin="0,0,0,4"
                      ToolTip="开机时等待 TranslucentTB 启动后，重启它一次，让它重新应用任务栏透明效果"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Button Content="立即修复一次" Click="OnFixTranslucentTbNow" Padding="10,5" FontSize="12"
                        Background="#EEE" Foreground="#333" BorderThickness="0"/>
                <TextBlock x:Name="TranslucentTbStatus"
                           Text="TranslucentTB 需正在运行（Store 版会自动用 AUMID 启动）"
                           Foreground="#BBB" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>


            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="ScreenshotDirBox" FontSize="12" Foreground="#555"
                         Padding="6,4" Background="#F5F5F5" BorderBrush="#E0E0E0"/>
                <Button Grid.Column="1" Content="截图目录" Click="OnBrowseScreenshotDir"
                        Padding="8,4" Margin="4,0,0,0" FontSize="12"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="打开数据目录" Click="OnOpenDataDir" Padding="10,5" FontSize="12"
                        Background="#EEE" Foreground="#333" BorderThickness="0"/>
                <Button Content="打开截图目录" Click="OnOpenScreenshotDir" Padding="10,5" FontSize="12" Margin="6,0,0,0"
                        Background="#EEE" Foreground="#333" BorderThickness="0"/>
            </StackPanel>

            <Grid Margin="0,6,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="截图格式" FontSize="13" Foreground="#555" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1" x:Name="FormatCombo" FontSize="13" Width="80"
                          Background="White" BorderBrush="#DDD">
                    <ComboBoxItem Content="PNG" IsSelected="True"/>
                    <ComboBoxItem Content="JPG"/>
                </ComboBox>
            </Grid>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Slider x:Name="JpegQualitySlider" Grid.Column="0" Minimum="50" Maximum="100" TickFrequency="5"
                        IsSnapToTickEnabled="True" ValueChanged="JpegQualitySlider_ValueChanged" Margin="0,0,10,0"/>
                <TextBlock x:Name="JpegQualityLabel" Grid.Column="1" Text="90" Width="40" TextAlignment="Right"
                           FontSize="13" Foreground="#5B6ABF" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Text="JPG 截图质量（仅 JPG 格式生效）" Foreground="#BBB" FontSize="11" Margin="0,-6,0,6"/>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="截图方式" FontSize="13" Foreground="#555" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1" x:Name="CaptureModeCombo" FontSize="12" HorizontalAlignment="Left" Width="220"
                          Background="White" BorderBrush="#DDD">
                    <ComboBoxItem Content="当前显示器（推荐）"/>
                    <ComboBoxItem Content="窗口内容（原生分辨率）"/>
                    <ComboBoxItem Content="窗口可见区域"/>
                    <ComboBoxItem Content="自动（判断窗口是否全屏）"/>
                    <ComboBoxItem Content="整个屏幕（所有显示器）"/>
                </ComboBox>
            </Grid>
            <TextBlock Text="默认按当前显示器截取（Magpie 超分后也能截到完整画面）；截出来带上游戏标题栏时，改用「窗口可见区域」"
                       Foreground="#BBB" FontSize="11" Margin="0,-4,0,6" TextWrapping="Wrap"/>

            <CheckBox x:Name="MagpieNativeCheckBox"
                      Content="检测到 Magpie 时优先抓取游戏原生分辨率（会带上窗口标题栏）"
                      FontSize="13" Foreground="#333" Margin="0,0,0,6"
                      ToolTip="Magpie 会在屏幕上放大画面；开启后用 PrintWindow 抓窗口自身的渲染内容，得到游戏原生分辨率的截图，但也会把窗口标题栏一起截进去。关闭时按「当前显示器」截取超分后的画面"/>

            <Separator Margin="0,12,0,16"/>

            <!-- ═══ OCR ═══ -->
            <Border Height="1" Background="#E5E5EA" Margin="0,22,0,0"/><TextBlock x:Name="SecHeaderCapture" Text="截图与黑边" FontSize="16" FontWeight="SemiBold" Foreground="#1D1D1F" Margin="0,16,0,12"/><TextBlock Text="截图后的黑边处理（直接改截图文件）" FontSize="13" Foreground="#555" Margin="0,0,0,4"/>
            <ComboBox x:Name="BarModeCombo" FontSize="13" Padding="6,4" Margin="0,0,0,6"
                      Background="White" BorderBrush="#DDD">
                <ComboBoxItem Content="不操作"/>
                <ComboBoxItem Content="黑边涂黑（尺寸不变）"/>
                <ComboBoxItem Content="黑边涂白（尺寸不变）"/>
                <ComboBoxItem Content="裁掉黑边（只留画面）"/>
            </ComboBox>
            <TextBlock Text="四边微调（像素，正数=多裁/多涂一点，负数=少裁、留一点）"
                       FontSize="11" Foreground="#888" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="左" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox x:Name="BarAdjLBox" Width="46" FontSize="12" Padding="6,4" Background="White" BorderBrush="#DDD"/>
                <TextBlock Text="右" FontSize="12" VerticalAlignment="Center" Margin="10,0,4,0"/>
                <TextBox x:Name="BarAdjRBox" Width="46" FontSize="12" Padding="6,4" Background="White" BorderBrush="#DDD"/>
                <TextBlock Text="上" FontSize="12" VerticalAlignment="Center" Margin="10,0,4,0"/>
                <TextBox x:Name="BarAdjTBox" Width="46" FontSize="12" Padding="6,4" Background="White" BorderBrush="#DDD"/>
                <TextBlock Text="下" FontSize="12" VerticalAlignment="Center" Margin="10,0,4,0"/>
                <TextBox x:Name="BarAdjBBox" Width="46" FontSize="12" Padding="6,4" Background="White" BorderBrush="#DDD"/>
            </StackPanel>
            <TextBlock Text="批量：主界面「···」→「批量处理截图黑边」；单条：右键语录 →「黑边处理…」（可微调 + 还原原图）"
                       FontSize="11" Foreground="#BBB" Margin="0,0,0,12" TextWrapping="Wrap"/>

            <Border Height="1" Background="#E5E5EA" Margin="0,22,0,0"/><TextBlock x:Name="SecHeaderBackup" Text="数据与备份" FontSize="16" FontWeight="SemiBold" Foreground="#1D1D1F" Margin="0,16,0,12"/><CheckBox x:Name="BackupCheckBox"
                      Content="每天首次启动自动备份（有变动才备份）"
                      FontSize="13" Foreground="#333" Margin="0,0,0,6"
                      ToolTip="备份 quotes.db、usage.json、settings.json + 截图目录。
每天只备份一次；如果数据与上次备份完全相同就跳过。
位置默认是「安装目录上一级\Gal Quote Tool Backup」。"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="最多保留" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Grid.Column="1" x:Name="BackupKeepBox" Width="54" FontSize="12" Padding="6,4"
                         Background="White" BorderBrush="#DDD" VerticalContentAlignment="Center"
                         ToolTip="最多保留几份备份（默认 3，范围 1-30）"/>
                <Button Grid.Column="2" Content="打开目录" Click="OnOpenBackupDir" Margin="6,0,0,0"
                        Padding="10,5" FontSize="12"/>
                <Button Grid.Column="3" Content="立即备份" Click="OnBackupNow" Margin="6,0,0,0"
                        Padding="10,5" FontSize="12"/>
            </Grid>
            <TextBlock Text="备份位置（可以填 NAS 路径，如 \\NAS\share\GalQuoteBackup）"
                       FontSize="12" Foreground="#888" Margin="0,6,0,4"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="BackupDirBox" FontSize="12" Padding="6,4"
                         Background="White" BorderBrush="#DDD" VerticalContentAlignment="Center"
                         ToolTip="留空 = 安装目录上一级的 Gal Quote Tool Backup"/>
                <Button Grid.Column="1" Content="浏览…" Click="OnBrowseBackupDir" Margin="6,0,0,0" Padding="10,5" FontSize="12"/>
                <Button Grid.Column="2" Content="恢复默认" Click="OnResetBackupDir" Margin="6,0,0,0" Padding="10,5" FontSize="12"/>
                <Button Grid.Column="3" Content="迁移已有备份" Click="OnMigrateBackups" Margin="6,0,0,0" Padding="10,5" FontSize="12"/>
            </Grid>
            <CheckBox x:Name="BackupZipCheck" Content="压缩成 zip（单文件，适合放 NAS / 网盘；不勾则存文件夹，便于单独还原某个文件）"
                      FontSize="12" Foreground="#333" Margin="0,4,0,6"/>            <TextBlock x:Name="BackupHintText" Text=""
                       Foreground="#BBB" FontSize="11" Margin="0,0,0,14" TextWrapping="Wrap"/>

            <Border Height="1" Background="#E5E5EA" Margin="0,22,0,0"/><TextBlock x:Name="SecHeaderWeb" Text="网页与手机" FontSize="16" FontWeight="SemiBold" Foreground="#1D1D1F" Margin="0,16,0,12"/><CheckBox x:Name="WebCheckBox"
                      Content="开启内网网页（手机 / 电脑浏览器查看、搜索、修改、导出语录）"
                      FontSize="13" Foreground="#333" Margin="0,0,0,6"
                      ToolTip="在程序里起一个极简网页服务，同一局域网内的手机/电脑打开下面的网址即可访问。
默认局域网免密；如果要暴露到公网，请设置访问码，并自己在路由器/反向代理上做好 HTTPS。"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="端口" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Grid.Column="1" x:Name="WebPortBox" Width="70" FontSize="12" Padding="6,4"
                         Background="White" BorderBrush="#DDD" VerticalContentAlignment="Center"/>
                <TextBox Grid.Column="2" x:Name="WebCodeBox" FontSize="12" Padding="6,4" Margin="8,0,0,0"
                         Background="White" BorderBrush="#DDD" VerticalContentAlignment="Center"
                         ToolTip="留空 = 局域网免密；填了就要求 http://…/?k=访问码"/>
                <Button Grid.Column="3" Content="生成强访问码" Click="OnGenWebCode" Margin="6,0,0,0"
                        Padding="10,5" FontSize="12"/>
                <Button Grid.Column="4" Content="打开网页" Click="OnOpenWebPage" Margin="6,0,0,0"
                        Padding="10,5" FontSize="12"/>
            </Grid>
            <CheckBox x:Name="WebAllowLanCheck" Content="允许局域网访问（手机 / 平板 / 电视盒子连同一个 WiFi 就能打开）"
                      FontSize="13" Foreground="#333" Margin="0,0,0,4"
                      Checked="WebNetCheck_Changed" Unchecked="WebNetCheck_Changed"
                      ToolTip="关闭 = 只监听 127.0.0.1，除了这台电脑谁都连不上（默认关闭，最安全）。"/>
            <CheckBox x:Name="WebAllowExternalCheck" Content="允许公网访问（经 Cloudflare tunnel / 反向代理进来的请求）"
                      FontSize="13" Foreground="#333" Margin="0,0,0,4"
                      Checked="WebNetCheck_Changed" Unchecked="WebNetCheck_Changed"
                      ToolTip="默认关闭：只要请求是从公网/tunnel 进来的，一律 403。
打开后：公网只能查看和导出（只读，不能修改），并且必须通过下面的访问码 + 两步验证。
和「允许局域网访问」是两把独立的锁，可以只开其中一个。"/>
            <CheckBox x:Name="WebTotpCheck" Content="公网访问需要两步验证（TOTP 动态码，局域网不用）"
                      FontSize="13" Foreground="#333" Margin="0,0,0,4"
                      Checked="WebTotpCheck_Changed" Unchecked="WebTotpCheck_Changed"
                      ToolTip="用手机上的验证器 App（Microsoft / Google Authenticator、Aegis 等）生成 6 位动态码。
只对公网生效；验证一次后 12 小时内不用再输。"/>
            <StackPanel x:Name="WebTotpPanel" Margin="0,0,0,6">
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="免验证" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="1" x:Name="WebTotpHoursBox" Width="52" FontSize="12" Padding="6,4"
                             Background="White" BorderBrush="#DDD" VerticalContentAlignment="Center"
                             ToolTip="通过验证后多少小时内不用再输动态码（1-720，默认 12）"/>
                    <TextBlock Grid.Column="2" Text="小时" FontSize="12" VerticalAlignment="Center" Margin="4,0,10,0"/>
                    <Button Grid.Column="3" Content="生成新密钥" Click="OnGenTotpSecret" Padding="10,5" FontSize="12"/>
                    <Button Grid.Column="4" Content="显示二维码" Click="OnShowTotpQr" Margin="6,0,0,0"
                            Padding="10,5" FontSize="12"
                            ToolTip="需要二维码插件（plugins\GalQuoteCollector.Plugins.Qr.dll）；没装插件就手动输入密钥。"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="复制 otpauth 链接" Click="OnCopyOtpauth" Padding="10,5" FontSize="12"/>
                </StackPanel>
                <TextBox x:Name="WebTotpSecretBox" FontSize="12" Padding="6,5" IsReadOnly="True"
                         Background="#F7F7FA" BorderBrush="#E0E0E0" FontFamily="Consolas"
                         ToolTip="在验证器 App 里选「手动输入密钥」（基于时间 / TOTP），把这一串（空格可以不管）填进去。"/>
                <TextBlock x:Name="WebTotpUriText" Text="" Foreground="#8E8E93" FontSize="11"
                           Margin="0,3,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="WebTotpHintText" Text="" Foreground="#BBB" FontSize="11"
                           Margin="2,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <TextBlock Text="访问协议" FontSize="13" Foreground="#555" Margin="0,0,0,4"/>
            <ComboBox x:Name="WebTlsCombo" FontSize="13" Margin="0,0,0,4"
                      Background="White" BorderBrush="#DDD"
                      SelectionChanged="WebTlsCombo_SelectionChanged"
                      ToolTip="「自动」= 同一个端口同时接受 http:// 与 https://：Cloudflare tunnel / 反向代理的 origin 不管填 http://127.0.0.1:端口 还是 https:// 都能连（推荐）。
「仅 HTTP」= 明文，tunnel 的 origin 必须填 http://，否则会 SSL handshake failed / 502。
「仅 HTTPS」= 自签证书，浏览器第一次会提示「不安全」，选继续访问即可；云端的反向代理默认会校验证书，需要在它那边关掉校验（Cloudflare tunnel 的 No TLS Verify）。">
                <ComboBoxItem Content="自动（HTTP / HTTPS 都能连，推荐）"/>
                <ComboBoxItem Content="仅 HTTP（明文）"/>
                <ComboBoxItem Content="仅 HTTPS（自签证书）"/>
            </ComboBox>
            <TextBlock x:Name="WebHintText" Text="访问码留空 = 局域网免密（同一 WiFi 下谁都能改）；"
                       Foreground="#BBB" FontSize="11" Margin="0,0,0,2" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                <Button Content="在本机信任（消除浏览器警告）" Click="OnTrustCert" Padding="10,5" FontSize="12"/>
                <Button Content="导出证书（给手机安装）" Click="OnExportCert" Padding="10,5" FontSize="12" Margin="6,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="WebUrlText" Text="" Foreground="#5B6ABF" FontSize="11"
                       Margin="0,0,0,2" TextWrapping="Wrap"/>
            <TextBlock x:Name="WebTvUrlText" Text="" Foreground="#2E7D5B" FontSize="11"
                       Margin="0,0,0,2" TextWrapping="Wrap"/>
            <TextBlock Text="手机连不上？① 手机要和电脑在同一个 WiFi（手机 IP 应为 192.168.2.x）；② 关掉手机上的 VPN / 代理；③ 路由器若开了「AP 隔离 / 客户端隔离」或用了访客网络，局域网设备之间互不可见；④ 选了「仅 HTTPS」时网址必须写 https:// 开头。用 Cloudflare tunnel / 反向代理时，origin 建议填 http://127.0.0.1:端口（填 https:// 会报 SSL handshake failed / 502，除非在那边关掉证书校验）。"
                       Foreground="#BBB" FontSize="11" Margin="0,0,0,14" TextWrapping="Wrap"/>

            <TextBlock Text="采集延迟" FontSize="13" Foreground="#555" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Slider Grid.Column="0" x:Name="DelaySlider" Minimum="0" Maximum="2000"
                        TickFrequency="100" IsSnapToTickEnabled="True"
                        ValueChanged="DelaySlider_ValueChanged" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" x:Name="DelayLabel" Text="200ms" VerticalAlignment="Center"
                           Width="90" FontSize="13" Foreground="#5B6ABF" FontWeight="SemiBold"/>
            </Grid>

            <Border Height="1" Background="#E5E5EA" Margin="0,22,0,0"/><TextBlock x:Name="SecHeaderOcr" Text="OCR 识别" FontSize="16" FontWeight="SemiBold" Foreground="#1D1D1F" Margin="0,16,0,8"/>
            <TextBlock Text="采集时用哪个引擎识别截图文字" Foreground="#888" FontSize="12" Margin="0,0,0,8"/>

            <TextBlock Text="识别引擎" FontSize="13" Foreground="#555" Margin="0,0,0,4"/>
            <ComboBox x:Name="OcrEngineCombo" FontSize="13" Margin="0,0,0,6"
                      Background="White" BorderBrush="#DDD"
                      SelectionChanged="OcrEngineCombo_SelectionChanged">
                <ComboBoxItem Content="Win OCR（Windows 内置）"/>
                <ComboBoxItem Content="本地模型（Qwen · Ollama）"/>
                <ComboBoxItem Content="RapidOCR（本地离线）"/>
            </ComboBox>

            <StackPanel x:Name="LocalOcrPanel" Visibility="Collapsed">
                <TextBlock Text="服务地址" FontSize="12" Foreground="#555" Margin="0,0,0,2"/>
                <TextBox x:Name="LocalOcrUrlBox" FontSize="12" Padding="6,4" Margin="0,0,0,6"
                         Background="#F5F5F5" BorderBrush="#E0E0E0"/>
                <TextBlock Text="模型名" FontSize="12" Foreground="#555" Margin="0,0,0,2"/>
                <TextBox x:Name="LocalOcrModelBox" FontSize="12" Padding="6,4" Margin="0,0,0,6"
                         Background="#F5F5F5" BorderBrush="#E0E0E0"/>
                <TextBlock Text="需本机运行 Ollama 并已拉取模型（默认 http://localhost:11434 · qwen2.5vl:7b）"
                           Foreground="#BBB" FontSize="11" Margin="0,0,0,6"/>
            </StackPanel>

            <StackPanel x:Name="RapidOcrPanel" Visibility="Collapsed">
                <TextBlock Text="Python 路径（装有 RapidOCR 的 python.exe）" FontSize="12" Foreground="#555" Margin="0,0,0,2"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="RapidOcrPythonBox" FontSize="12" Padding="6,4"
                             VerticalContentAlignment="Center" Background="#F5F5F5" BorderBrush="#E0E0E0"/>
                    <Button Grid.Column="1" Content="浏览..." Click="OnBrowseRapidPython"
                            Padding="8,4" Margin="4,0,0,0" FontSize="12"/>
                    <Button Grid.Column="2" Content="检测" Click="OnCheckRapid"
                            Padding="8,4" Margin="4,0,0,0" FontSize="12"/>
                </Grid>
                <TextBlock x:Name="RapidOcrStatus"
                           Text="留空自动探测；识别时会在本机搜索已安装的 RapidOCR"
                           Foreground="#BBB" FontSize="11" Margin="0,0,0,6"/>
            </StackPanel>

            <Separator Margin="0,12,0,16"/>

            <!-- ═══ Game Name Rules ═══ -->
            <Border Height="1" Background="#E5E5EA" Margin="0,22,0,0"/><TextBlock x:Name="SecHeaderRules" Text="游戏名匹配规则" FontSize="16" Margin="0,16,0,8" FontWeight="SemiBold" Foreground="#1D1D1F"/>
            <TextBlock Text="窗口标题包含关键词时，自动映射到指定游戏名。匹配优先级：关键词最长的优先。"
                       Foreground="#888" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <TextBlock Text="Ctrl+点击某条规则可直接删除它"
                       Foreground="#5B6ABF" FontSize="12" Margin="0,0,0,8"/>

            <!-- Rules list -->
            <ItemsControl x:Name="RulesList" Margin="0,0,0,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,5" Margin="0,0,0,4" BorderBrush="#EEE" BorderThickness="0 0 0 1"
                                MouseDown="OnRuleMouseDown" Cursor="Hand"
                                ToolTip="Ctrl+点击删除该规则">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#EEF0FF" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding Match}" FontWeight="SemiBold" Foreground="#5B6ABF" FontSize="12"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="→" Foreground="#CCC" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="#333" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Add rule row -->
            <TextBlock Text="添加新规则" FontSize="12" Foreground="#888" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="RuleMatchBox"
                         Padding="8,5" VerticalContentAlignment="Center"
                         Background="White" BorderBrush="#DDD" FontSize="13"/>
                <TextBox Grid.Column="1" x:Name="RuleNameBox" Width="140"
                         Padding="8,5" Margin="6,0,6,0" VerticalContentAlignment="Center"
                         Background="White" BorderBrush="#DDD" FontSize="13"/>
                <Button Grid.Column="2" Content="添加" Click="OnAddRule"
                        Padding="12,5" Background="#5B6ABF" Foreground="White" BorderThickness="0"
                        FontSize="13" Cursor="Hand"/>
            </Grid>
            <Button Content="删除最后一条" Click="OnRemoveRule"
                    Padding="8,3" Background="#F5F5F5" Foreground="#999" BorderThickness="1" BorderBrush="#DDD"
                    FontSize="11" HorizontalAlignment="Left" Margin="0,0,0,4" Cursor="Hand"/>

            <!-- ═══ Save / Cancel ═══ -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="查看日志" Click="OnViewLog"
                        Padding="10,7" Margin="0,0,8,0"
                        Background="#EEE" Foreground="#333" BorderThickness="0"
                        FontSize="12" Cursor="Hand" ToolTip="打开 %LOCALAPPDATA%\GalQuoteCollector\startup.log"/>
                <Button Content="恢复默认" Click="OnResetDefaults"
                        Padding="10,7" Margin="0,0,8,0"
                        Background="#EEE" Foreground="#333" BorderThickness="0"
                        FontSize="12" Cursor="Hand"/>
                <Button x:Name="SaveButton" Content="保存" IsEnabled="False"
                        Padding="18,7" Margin="0,0,8,0"
                        Click="OnSaveClick"
                        Background="#5B6ABF" Foreground="White" BorderThickness="0"
                        FontSize="13" FontWeight="SemiBold" Cursor="Hand"/>
                <Button Content="取消" Padding="18,7"
                        Click="OnCancelClick"
                        Background="#EEE" Foreground="#333" BorderThickness="0"
                        FontSize="13" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
