<Window x:Class="GalQuoteCollector.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="480" Height="580"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F5F7"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <ScrollViewer Padding="24,20">
        <StackPanel>

            <!-- ═══ Hotkey ═══ -->
            <TextBlock Text="快捷键" FontSize="16" FontWeight="SemiBold" Foreground="#1D1D1F" Margin="0,0,0,6"/>
            <TextBlock Text="在此窗口打开时，直接按下你想用的快捷键组合"
                       Foreground="#888" FontSize="12" Margin="0,0,0,10"/>
            <Border x:Name="HotkeyBox"
                    BorderBrush="#5B6ABF" BorderThickness="2"
                    Background="#EEF0FF" Height="38" Padding="12,0"
                    CornerRadius="8"
                    MouseDown="HotkeyBox_MouseDown" Cursor="Hand">
                <TextBlock x:Name="HotkeyDisplay" Text="按键即捕获..."
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           FontSize="15" FontWeight="Bold" Foreground="#5B6ABF"/>
            </Border>
            <TextBlock x:Name="CurrentHotkeyText" Foreground="#888" FontSize="12" Margin="0,8,0,0"/>

            <TextBlock Text="补拍（为当前语录追加截图）" FontSize="13" Foreground="#555" Margin="0,12,0,4"/>
            <Border x:Name="AddShotBox"
                    BorderBrush="#5B6ABF" BorderThickness="2"
                    Background="#EEF0FF" Height="38" Padding="12,0"
                    CornerRadius="8"
                    MouseDown="AddShotBox_MouseDown" Cursor="Hand">
                <TextBlock x:Name="AddShotDisplay" Text="按键即捕获..."
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           FontSize="15" FontWeight="Bold" Foreground="#5B6ABF"/>
            </Border>
            <TextBlock x:Name="CurrentAddShotText" Foreground="#888" FontSize="12" Margin="0,8,0,0"/>

            <Separator Margin="0,18,0,16"/>

            <!-- ═══ General ═══ -->
            <TextBlock Text="常规" FontSize="16" FontWeight="SemiBold" Foreground="#1D1D1F" Margin="0,0,0,12"/>

            <CheckBox x:Name="AutoStartCheckBox" Content="开机时自动启动（最小化到任务栏）"
                      FontSize="13" Foreground="#333" Margin="0,0,0,14"/>

            <TextBlock Text="采集延迟" FontSize="13" Foreground="#555" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Slider Grid.Column="0" x:Name="DelaySlider" Minimum="0" Maximum="2000"
                        TickFrequency="100" IsSnapToTickEnabled="True"
                        ValueChanged="DelaySlider_ValueChanged" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" x:Name="DelayLabel" Text="200ms" VerticalAlignment="Center"
                           Width="90" FontSize="13" Foreground="#5B6ABF" FontWeight="SemiBold"/>
            </Grid>

            <TextBlock Text="回想模式" FontSize="13" Foreground="#555" Margin="0,0,0,4"/>
            <ComboBox x:Name="SlideshowModeCombo" FontSize="13" Margin="0,0,0,4"
                      Background="White" BorderBrush="#DDD">
                <ComboBoxItem Content="按时间顺序"/>
                <ComboBoxItem Content="随机顺序"/>
            </ComboBox>
            <CheckBox x:Name="SlideshowLoopCheckBox" Content="循环播放（到末尾自动回到开头）"
                      FontSize="13" Foreground="#333" Margin="0,0,0,6"/>

            <TextBlock Text="回想中文字体" FontSize="13" Foreground="#555" Margin="0,0,0,4"/>
            <ComboBox x:Name="SlideshowChineseFontCombo" FontSize="13" Margin="0,0,0,4"
                      Background="White" BorderBrush="#DDD"
                      DisplayMemberPath="Source"/>
            <TextBlock Text="回想英文字体" FontSize="13" Foreground="#555" Margin="0,0,0,4"/>
            <ComboBox x:Name="SlideshowEnglishFontCombo" FontSize="13" Margin="0,0,0,6"
                      Background="White" BorderBrush="#DDD"
                      DisplayMemberPath="Source"/>

            <!-- ═══ Magpie 超分（回想） ═══ -->
            <CheckBox x:Name="MagpieSlideshowCheckBox"
                      Content="回想时用 Magpie 超分（需 Magpie 正在运行）"
                      FontSize="13" Foreground="#333" Margin="0,0,0,4"
                      ToolTip="打开回想窗口后自动发送 Magpie 的「缩放窗口」热键，由 Magpie 接管并超分回想画面；关闭回想时自动解除"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="MagpieHotkeyBox" FontSize="12" Padding="6,4"
                         VerticalContentAlignment="Center" Background="#F5F5F5" BorderBrush="#E0E0E0"
                         ToolTip="Magpie「缩放窗口」热键，如 Alt+Shift+A；留空则自动读取 Magpie 配置"/>
                <Button Grid.Column="1" Content="读取 Magpie 配置" Click="OnReadMagpieHotkey"
                        Padding="8,4" Margin="4,0,0,0" FontSize="12"/>
                <Button Grid.Column="2" Content="测试" Click="OnTestMagpieHotkey"
                        Padding="8,4" Margin="4,0,0,0" FontSize="12"/>
            </Grid>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="MagpiePathBox" FontSize="12" Padding="6,4"
                         VerticalContentAlignment="Center" Background="#F5F5F5" BorderBrush="#E0E0E0"
                         ToolTip="Magpie.exe 路径，留空则自动探测"/>
                <Button Grid.Column="1" Content="浏览..." Click="OnBrowseMagpiePath"
                        Padding="8,4" Margin="4,0,0,0" FontSize="12"/>
            </Grid>
            <TextBlock x:Name="MagpieStatusText"
                       Text="热键留空自动读取 Magpie 配置；点「测试」可验证热键是否真的触发 Magpie"
                       Foreground="#BBB" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"/>

            <TextBlock Text="界面字体" FontSize="13" Foreground="#555" Margin="0,0,0,4"/>
            <ComboBox x:Name="FontCombo" FontSize="13" Margin="0,0,0,6"
                      Background="White" BorderBrush="#DDD"
                      DisplayMemberPath="Source"/>
            <TextBlock Text="需重启后生效" Foreground="#BBB" FontSize="11" Margin="0,-4,0,6"/>

            <CheckBox x:Name="EnableTrackingCheckBox" Content="启用使用时长记录"
                      FontSize="13" Foreground="#333" Margin="0,0,0,6"/>

            <CheckBox x:Name="HideUnrecognizedCheckBox" Content="搜索结果排除「[未识别到文字]」"
                      FontSize="13" Foreground="#333" Margin="0,0,0,6"/>

            <CheckBox x:Name="TranslucentTbFixCheckBox"
                      Content="TranslucentTB修复：开机自动重启一次 TranslucentTB，修复任务栏透明偶尔失效"
                      FontSize="13" Foreground="#333" Margin="0,0,0,4"
                      ToolTip="开机时等待 TranslucentTB 启动后，重启它一次，让它重新应用任务栏透明效果"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Button Content="立即修复一次" Click="OnFixTranslucentTbNow" Padding="10,5" FontSize="12"
                        Background="#EEE" Foreground="#333" BorderThickness="0"/>
                <TextBlock x:Name="TranslucentTbStatus"
                           Text="TranslucentTB 需正在运行（Store 版会自动用 AUMID 启动）"
                           Foreground="#BBB" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>


            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="ScreenshotDirBox" FontSize="12" Foreground="#555"
                         Padding="6,4" Background="#F5F5F5" BorderBrush="#E0E0E0"/>
                <Button Grid.Column="1" Content="截图目录" Click="OnBrowseScreenshotDir"
                        Padding="8,4" Margin="4,0,0,0" FontSize="12"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="打开数据目录" Click="OnOpenDataDir" Padding="10,5" FontSize="12"
                        Background="#EEE" Foreground="#333" BorderThickness="0"/>
                <Button Content="打开截图目录" Click="OnOpenScreenshotDir" Padding="10,5" FontSize="12" Margin="6,0,0,0"
                        Background="#EEE" Foreground="#333" BorderThickness="0"/>
            </StackPanel>

            <Grid Margin="0,6,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="截图格式" FontSize="13" Foreground="#555" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1" x:Name="FormatCombo" FontSize="13" Width="80"
                          Background="White" BorderBrush="#DDD">
                    <ComboBoxItem Content="PNG" IsSelected="True"/>
                    <ComboBoxItem Content="JPG"/>
                </ComboBox>
            </Grid>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Slider x:Name="JpegQualitySlider" Grid.Column="0" Minimum="50" Maximum="100" TickFrequency="5"
                        IsSnapToTickEnabled="True" ValueChanged="JpegQualitySlider_ValueChanged" Margin="0,0,10,0"/>
                <TextBlock x:Name="JpegQualityLabel" Grid.Column="1" Text="90" Width="40" TextAlignment="Right"
                           FontSize="13" Foreground="#5B6ABF" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Text="JPG 截图质量（仅 JPG 格式生效）" Foreground="#BBB" FontSize="11" Margin="0,-6,0,6"/>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="截图方式" FontSize="13" Foreground="#555" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1" x:Name="CaptureModeCombo" FontSize="12" HorizontalAlignment="Left" Width="220"
                          Background="White" BorderBrush="#DDD">
                    <ComboBoxItem Content="当前显示器（推荐）"/>
                    <ComboBoxItem Content="窗口内容（原生分辨率）"/>
                    <ComboBoxItem Content="窗口可见区域"/>
                    <ComboBoxItem Content="自动（判断窗口是否全屏）"/>
                    <ComboBoxItem Content="整个屏幕（所有显示器）"/>
                </ComboBox>
            </Grid>
            <TextBlock Text="默认按当前显示器截取（Magpie 超分后也能截到完整画面）；截出来带上游戏标题栏时，改用「窗口可见区域」"
                       Foreground="#BBB" FontSize="11" Margin="0,-4,0,6" TextWrapping="Wrap"/>

            <CheckBox x:Name="MagpieNativeCheckBox"
                      Content="检测到 Magpie 时优先抓取游戏原生分辨率（会带上窗口标题栏）"
                      FontSize="13" Foreground="#333" Margin="0,0,0,6"
                      ToolTip="Magpie 会在屏幕上放大画面；开启后用 PrintWindow 抓窗口自身的渲染内容，得到游戏原生分辨率的截图，但也会把窗口标题栏一起截进去。关闭时按「当前显示器」截取超分后的画面"/>

            <Separator Margin="0,12,0,16"/>

            <!-- ═══ OCR ═══ -->
            <TextBlock Text="OCR 识别" FontSize="16" FontWeight="SemiBold" Foreground="#1D1D1F" Margin="0,0,0,6"/>
            <TextBlock Text="采集时用哪个引擎识别截图文字" Foreground="#888" FontSize="12" Margin="0,0,0,8"/>

            <TextBlock Text="识别引擎" FontSize="13" Foreground="#555" Margin="0,0,0,4"/>
            <ComboBox x:Name="OcrEngineCombo" FontSize="13" Margin="0,0,0,6"
                      Background="White" BorderBrush="#DDD"
                      SelectionChanged="OcrEngineCombo_SelectionChanged">
                <ComboBoxItem Content="Win OCR（Windows 内置）"/>
                <ComboBoxItem Content="本地模型（Qwen · Ollama）"/>
                <ComboBoxItem Content="RapidOCR（本地离线）"/>
            </ComboBox>

            <StackPanel x:Name="LocalOcrPanel" Visibility="Collapsed">
                <TextBlock Text="服务地址" FontSize="12" Foreground="#555" Margin="0,0,0,2"/>
                <TextBox x:Name="LocalOcrUrlBox" FontSize="12" Padding="6,4" Margin="0,0,0,6"
                         Background="#F5F5F5" BorderBrush="#E0E0E0"/>
                <TextBlock Text="模型名" FontSize="12" Foreground="#555" Margin="0,0,0,2"/>
                <TextBox x:Name="LocalOcrModelBox" FontSize="12" Padding="6,4" Margin="0,0,0,6"
                         Background="#F5F5F5" BorderBrush="#E0E0E0"/>
                <TextBlock Text="需本机运行 Ollama 并已拉取模型（默认 http://localhost:11434 · qwen2.5vl:7b）"
                           Foreground="#BBB" FontSize="11" Margin="0,0,0,6"/>
            </StackPanel>

            <StackPanel x:Name="RapidOcrPanel" Visibility="Collapsed">
                <TextBlock Text="Python 路径（装有 RapidOCR 的 python.exe）" FontSize="12" Foreground="#555" Margin="0,0,0,2"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="RapidOcrPythonBox" FontSize="12" Padding="6,4"
                             VerticalContentAlignment="Center" Background="#F5F5F5" BorderBrush="#E0E0E0"/>
                    <Button Grid.Column="1" Content="浏览..." Click="OnBrowseRapidPython"
                            Padding="8,4" Margin="4,0,0,0" FontSize="12"/>
                    <Button Grid.Column="2" Content="检测" Click="OnCheckRapid"
                            Padding="8,4" Margin="4,0,0,0" FontSize="12"/>
                </Grid>
                <TextBlock x:Name="RapidOcrStatus"
                           Text="留空自动探测；识别时会在本机搜索已安装的 RapidOCR"
                           Foreground="#BBB" FontSize="11" Margin="0,0,0,6"/>
            </StackPanel>

            <Separator Margin="0,12,0,16"/>

            <!-- ═══ Game Name Rules ═══ -->
            <TextBlock Text="游戏名匹配规则" FontSize="16" FontWeight="SemiBold" Foreground="#1D1D1F" Margin="0,0,0,6"/>
            <TextBlock Text="窗口标题包含关键词时，自动映射到指定游戏名。匹配优先级：关键词最长的优先。"
                       Foreground="#888" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <TextBlock Text="Ctrl+点击某条规则可直接删除它"
                       Foreground="#5B6ABF" FontSize="12" Margin="0,0,0,8"/>

            <!-- Rules list -->
            <ItemsControl x:Name="RulesList" Margin="0,0,0,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,5" Margin="0,0,0,4" BorderBrush="#EEE" BorderThickness="0 0 0 1"
                                MouseDown="OnRuleMouseDown" Cursor="Hand"
                                ToolTip="Ctrl+点击删除该规则">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#EEF0FF" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding Match}" FontWeight="SemiBold" Foreground="#5B6ABF" FontSize="12"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="→" Foreground="#CCC" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="#333" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Add rule row -->
            <TextBlock Text="添加新规则" FontSize="12" Foreground="#888" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="RuleMatchBox"
                         Padding="8,5" VerticalContentAlignment="Center"
                         Background="White" BorderBrush="#DDD" FontSize="13"/>
                <TextBox Grid.Column="1" x:Name="RuleNameBox" Width="140"
                         Padding="8,5" Margin="6,0,6,0" VerticalContentAlignment="Center"
                         Background="White" BorderBrush="#DDD" FontSize="13"/>
                <Button Grid.Column="2" Content="添加" Click="OnAddRule"
                        Padding="12,5" Background="#5B6ABF" Foreground="White" BorderThickness="0"
                        FontSize="13" Cursor="Hand"/>
            </Grid>
            <Button Content="删除最后一条" Click="OnRemoveRule"
                    Padding="8,3" Background="#F5F5F5" Foreground="#999" BorderThickness="1" BorderBrush="#DDD"
                    FontSize="11" HorizontalAlignment="Left" Margin="0,0,0,4" Cursor="Hand"/>

            <!-- ═══ Save / Cancel ═══ -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="查看日志" Click="OnViewLog"
                        Padding="10,7" Margin="0,0,8,0"
                        Background="#EEE" Foreground="#333" BorderThickness="0"
                        FontSize="12" Cursor="Hand" ToolTip="打开 %LOCALAPPDATA%\GalQuoteCollector\startup.log"/>
                <Button Content="恢复默认" Click="OnResetDefaults"
                        Padding="10,7" Margin="0,0,8,0"
                        Background="#EEE" Foreground="#333" BorderThickness="0"
                        FontSize="12" Cursor="Hand"/>
                <Button x:Name="SaveButton" Content="保存" IsEnabled="False"
                        Padding="18,7" Margin="0,0,8,0"
                        Click="OnSaveClick"
                        Background="#5B6ABF" Foreground="White" BorderThickness="0"
                        FontSize="13" FontWeight="SemiBold" Cursor="Hand"/>
                <Button Content="取消" Padding="18,7"
                        Click="OnCancelClick"
                        Background="#EEE" Foreground="#333" BorderThickness="0"
                        FontSize="13" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
