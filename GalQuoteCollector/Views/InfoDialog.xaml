<Window x:Class="GalQuoteCollector.Views.InfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI"
        PreviewKeyDown="OnPreviewKeyDown"
        MouseLeftButtonDown="OnDragMove">
    <Border Background="White" CornerRadius="10" BorderBrush="#E0E0E0" BorderThickness="1" Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.28" Color="#333"/>
        </Border.Effect>
        <StackPanel Margin="22,18,18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="IconText" Grid.Column="0" FontFamily="Segoe MDL2 Assets" FontSize="24"
                           VerticalAlignment="Top" Margin="0,1,12,0"/>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Foreground="#1D1D1F" TextWrapping="Wrap"/>
                    <TextBlock x:Name="MessageText" FontSize="13" Foreground="#444" TextWrapping="Wrap"
                               Margin="0,8,0,0" LineHeight="20"/>
                </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="OkBtn" Content="确定" Click="OnOk" Padding="18,6"
                        Background="#5B6ABF" Foreground="White" BorderThickness="0" FontSize="13" FontWeight="SemiBold"/>
                <Button x:Name="NoBtn" Content="否" Click="OnNo" Padding="18,6" Margin="8,0,0,0"
                        Background="#EEE" Foreground="#333" BorderThickness="0" FontSize="13" Visibility="Collapsed"/>
                <Button x:Name="CancelBtn" Content="取消" Click="OnCancel" Padding="18,6" Margin="8,0,0,0"
                        Background="#EEE" Foreground="#333" BorderThickness="0" FontSize="13" Visibility="Collapsed"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
