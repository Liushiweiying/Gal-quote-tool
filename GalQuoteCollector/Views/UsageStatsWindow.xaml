<Window x:Class="GalQuoteCollector.Views.UsageStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="时长记录"
        Width="520" Height="480"
        MinWidth="400" MinHeight="350"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F7" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="ModeToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#EEE"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5B6ABF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DDE1F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Date navigation + view mode -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" BorderBrush="#E8E8E8" BorderThickness="1"
                Padding="8,6" Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06" Color="#666"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ToggleButton x:Name="DayModeBtn" Content="按天" Click="OnDayMode" IsChecked="True"
                                  Style="{StaticResource ModeToggle}" Padding="14,5" Margin="0,0,6,0" FontSize="12"/>
                    <ToggleButton x:Name="WeekModeBtn" Content="本周" Click="OnWeekMode"
                                  Style="{StaticResource ModeToggle}" Padding="14,5" FontSize="12"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="DateText" Text="选择日期" FontSize="14" FontWeight="SemiBold"
                           Foreground="#1D1D1F" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Cursor="Hand" MouseDown="OnDateClick" ToolTip="点击选择日期"/>
                <StackPanel Grid.Column="2" x:Name="DateNavPanel" Orientation="Horizontal">
                    <Button Click="OnPrevDay" Width="30" Height="30" Padding="0" Margin="0,0,6,0"
                            Background="#EEE" Foreground="#555" BorderThickness="0"
                            FontFamily="Segoe MDL2 Assets" Content="&#xE76B;" ToolTip="前一天"/>
                    <Button Click="OnNextDay" Width="30" Height="30" Padding="0" Margin="0,0,6,0"
                            Background="#EEE" Foreground="#555" BorderThickness="0"
                            FontFamily="Segoe MDL2 Assets" Content="&#xE76C;" ToolTip="后一天"/>
                    <Button Click="OnDateClick" Width="30" Height="30" Padding="0"
                            Background="#5B6ABF" Foreground="White" BorderThickness="0"
                            FontFamily="Segoe MDL2 Assets" Content="&#xE787;" ToolTip="选择日期"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Stats content -->
        <ScrollViewer Grid.Row="1" Margin="0,0,0,10" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="StatsPanel"/>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="管理黑名单" Click="OnManageBlacklist" Padding="12,6" FontSize="12"
                    Background="#EEE" Foreground="#333" BorderThickness="0" Cursor="Hand"/>
            <Button Content="导出" Click="OnExport" Padding="12,6" FontSize="12" Margin="6,0,0,0"
                    Background="#EEE" Foreground="#333" BorderThickness="0" Cursor="Hand"/>
            <Button Content="导入" Click="OnImport" Padding="12,6" FontSize="12" Margin="6,0,0,0"
                    Background="#EEE" Foreground="#333" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
