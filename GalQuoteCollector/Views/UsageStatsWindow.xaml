<Window x:Class="GalQuoteCollector.Views.UsageStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GalQuoteCollector.Converters"
        Title="使用时间"
        Width="620" Height="760"
        MinWidth="440" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="#F2F2F7" FontFamily="Segoe UI">
    <Window.Resources>
        <conv:UsageDateHighlightConverter x:Key="HasUsageDate"/>

        <!-- Days that have usage records are highlighted in the calendar -->
        <Style x:Key="DayButtonWithData" TargetType="CalendarDayButton">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Converter={StaticResource HasUsageDate}}" Value="True">
                    <Setter Property="Background" Value="#E3E8FF"/>
                    <Setter Property="Foreground" Value="#3B4BA8"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CalendarWithData" TargetType="Calendar">
            <Setter Property="CalendarDayButtonStyle" Value="{StaticResource DayButtonWithData}"/>
        </Style>

        <!-- iOS 分段控件样式 -->
        <Style x:Key="SegmentToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#3C3C43"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#1D1D1F"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#E2E2E8"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 + 区间导航 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="使用时间" FontSize="24" FontWeight="Bold" Foreground="#1D1D1F"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel x:Name="NavPanel" Orientation="Horizontal">
                    <Button Click="OnPrevPeriod" Width="28" Height="28" Padding="0" Margin="0,0,6,0"
                            Background="#E4E4EA" Foreground="#3C3C43" BorderThickness="0"
                            FontFamily="Segoe MDL2 Assets" Content="&#xE76B;" ToolTip="上一个时间段"/>
                    <Button Click="OnNextPeriod" Width="28" Height="28" Padding="0" Margin="0,0,6,0"
                            Background="#E4E4EA" Foreground="#3C3C43" BorderThickness="0"
                            FontFamily="Segoe MDL2 Assets" Content="&#xE76C;" ToolTip="下一个时间段"/>
                </StackPanel>
                <Button Click="OnPickRange" Height="28" Padding="10,0"
                        Background="#E4E4EA" Foreground="#3C3C43" BorderThickness="0" FontSize="12"
                        x:Name="RangeText" ToolTip="点击选择日期 / 自选区间"/>
            </StackPanel>
        </Grid>

        <!-- 时间段分段控件（单独一行，窄窗口也放得下） -->
        <Border Grid.Row="1" Background="#E4E4EA" CornerRadius="9" Padding="2"
                HorizontalAlignment="Left" Margin="0,10,0,10">
            <StackPanel x:Name="SegmentPanel" Orientation="Horizontal">
                <ToggleButton x:Name="DayModeBtn" Content="今天" Click="OnPeriodDay" IsChecked="True"
                              Style="{StaticResource SegmentToggle}" Padding="14,4" MinWidth="62"/>
                <ToggleButton x:Name="WeekModeBtn" Content="最近 7 天" Click="OnPeriodWeek"
                              Style="{StaticResource SegmentToggle}" Padding="14,4" MinWidth="78"/>
                <ToggleButton x:Name="MonthModeBtn" Content="本月" Click="OnPeriodMonth"
                              Style="{StaticResource SegmentToggle}" Padding="14,4" MinWidth="62"/>
                <ToggleButton x:Name="YearModeBtn" Content="今年" Click="OnPeriodYear"
                              Style="{StaticResource SegmentToggle}" Padding="14,4" MinWidth="62"/>
                <ToggleButton x:Name="CustomModeBtn" Content="自选…" Click="OnPeriodCustom"
                              Style="{StaticResource SegmentToggle}" Padding="14,4" MinWidth="70"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" x:Name="Scroll">
            <StackPanel x:Name="StatsPanel"/>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="应用名 / 锁屏进程" Click="OnManageProcessMap" Padding="12,6" FontSize="12"
                    Background="#E4E4EA" Foreground="#3C3C43" BorderThickness="0" Cursor="Hand"
                    ToolTip="自定义进程的显示名，以及哪些进程算锁屏"/>
            <Button Content="管理黑名单" Click="OnManageBlacklist" Padding="12,6" FontSize="12" Margin="6,0,0,0"
                    Background="#E4E4EA" Foreground="#3C3C43" BorderThickness="0" Cursor="Hand"/>
            <Button Content="导出" Click="OnExport" Padding="12,6" FontSize="12" Margin="6,0,0,0"
                    Background="#E4E4EA" Foreground="#3C3C43" BorderThickness="0" Cursor="Hand"/>
            <Button Content="导入" Click="OnImport" Padding="12,6" FontSize="12" Margin="6,0,0,0"
                    Background="#E4E4EA" Foreground="#3C3C43" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
