<Window x:Class="GalQuoteCollector.Views.UsageStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="时长记录"
        Width="520" Height="480"
        MinWidth="400" MinHeight="350"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F7" FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Date navigation -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" BorderBrush="#E8E8E8" BorderThickness="1"
                Padding="8,6" Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06" Color="#666"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Click="OnPrevDay" Width="30" Height="30" Padding="0"
                        Background="#EEE" Foreground="#555" BorderThickness="0"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE76B;" ToolTip="前一天"/>
                <TextBlock Grid.Column="1" x:Name="DateText" Text="选择日期" FontSize="14" FontWeight="SemiBold"
                           Foreground="#1D1D1F" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Cursor="Hand" MouseDown="OnDateClick" ToolTip="点击选择日期"/>
                <Button Grid.Column="2" Click="OnNextDay" Width="30" Height="30" Padding="0" Margin="0,0,6,0"
                        Background="#EEE" Foreground="#555" BorderThickness="0"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE76C;" ToolTip="后一天"/>
                <Button Grid.Column="3" Click="OnDateClick" Width="30" Height="30" Padding="0"
                        Background="#5B6ABF" Foreground="White" BorderThickness="0"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE787;" ToolTip="选择日期"/>
            </Grid>
        </Border>

        <!-- Stats content -->
        <ScrollViewer Grid.Row="1" Margin="0,0,0,10" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="StatsPanel"/>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="管理黑名单" Click="OnManageBlacklist" Padding="12,6" FontSize="12"
                    Background="#EEE" Foreground="#333" BorderThickness="0" Cursor="Hand"/>
            <Button Content="导出" Click="OnExport" Padding="12,6" FontSize="12" Margin="6,0,0,0"
                    Background="#EEE" Foreground="#333" BorderThickness="0" Cursor="Hand"/>
            <Button Content="导入" Click="OnImport" Padding="12,6" FontSize="12" Margin="6,0,0,0"
                    Background="#EEE" Foreground="#333" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
