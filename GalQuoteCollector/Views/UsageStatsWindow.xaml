<Window x:Class="GalQuoteCollector.Views.UsageStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="时长记录"
        Width="520" Height="480"
        MinWidth="400" MinHeight="350"
        WindowStartupLocation="CenterOwner"
        Background="#FFF" FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Date navigation -->
        <Border Grid.Row="0" Background="#F5F5F7" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="←" Click="OnPrevDay" Padding="8,4" FontSize="14" Background="#EEE" BorderThickness="0" Cursor="Hand"/>
                <TextBlock Grid.Column="1" x:Name="DateText" Text="选择日期" FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"
                           MouseDown="OnDateClick"/>
                <Button Grid.Column="2" Content="→" Click="OnNextDay" Padding="8,4" FontSize="14" Background="#EEE" BorderThickness="0" Cursor="Hand"/>
                <Button Grid.Column="3" Content="📅" Click="OnDateClick" Padding="8,4" FontSize="14" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="4,0,0,0"/>
            </Grid>
        </Border>

        <!-- Stats content -->
        <ScrollViewer Grid.Row="1" Margin="0,0,0,10" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="StatsPanel"/>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="管理黑名单" Click="OnManageBlacklist" Padding="10,5" FontSize="12"
                    Background="#EEE" Foreground="#333" BorderThickness="0" Cursor="Hand"/>
            <Button Content="导出" Click="OnExport" Padding="10,5" FontSize="12" Margin="6,0,0,0"
                    Background="#EEE" Foreground="#333" BorderThickness="0" Cursor="Hand"/>
            <Button Content="导入" Click="OnImport" Padding="10,5" FontSize="12" Margin="6,0,0,0"
                    Background="#EEE" Foreground="#333" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
