<Window x:Class="GalQuoteCollector.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="版本更新"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI"
        PreviewKeyDown="OnPreviewKeyDown">
    <Border Background="White" CornerRadius="10" BorderBrush="#E0E0E0" BorderThickness="1" Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.28" Color="#333"/>
        </Border.Effect>
        <StackPanel Margin="22,18">
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Foreground="#1D1D1F" TextWrapping="Wrap"/>
            <TextBlock x:Name="VersionText" FontSize="12" Foreground="#888" Margin="0,5,0,0"/>
            <TextBox x:Name="BodyBox" IsReadOnly="True" Height="190" Margin="0,12,0,0"
                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                     Background="#FAFAFA" BorderBrush="#E0E0E0" FontSize="12" Foreground="#444"/>
            <ProgressBar x:Name="ProgressBar" Height="6" Margin="0,12,0,0" Visibility="Collapsed"
                         Foreground="#5B6ABF" Minimum="0" Maximum="100"/>
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="#888" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="SkipBtn" Content="跳过此版本" Click="OnSkip" Padding="12,6" Margin="0,0,8,0"
                        Background="#EEE" Foreground="#555" BorderThickness="0" FontSize="12"/>
                <Button x:Name="CancelBtn" Content="取消" Click="OnCancel" Padding="12,6" Margin="0,0,8,0"
                        Background="#EEE" Foreground="#555" BorderThickness="0" FontSize="12"/>
                <Button x:Name="DownloadBtn" Content="下载并更新" Click="OnDownload" Padding="16,6"
                        Background="#5B6ABF" Foreground="White" BorderThickness="0" FontSize="13" FontWeight="SemiBold"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
