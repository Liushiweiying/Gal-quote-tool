<Window x:Class="GalQuoteCollector.Views.QrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="两步验证二维码" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F7F7FA" FontFamily="Segoe UI, Microsoft YaHei">
    <StackPanel Margin="18">
        <TextBlock Text="用手机验证器 App 扫这个码" FontSize="15" FontWeight="SemiBold" Foreground="#1D1D1F"/>
        <TextBlock Text="Microsoft / Google Authenticator、Aegis 等 → 添加账户 → 扫描二维码"
                   FontSize="12" Foreground="#8E8E93" Margin="0,3,0,0" TextWrapping="Wrap"/>
        <Border Background="White" CornerRadius="12" Padding="12" Margin="0,12,0,0" HorizontalAlignment="Center"
                BorderBrush="#E5E5EA" BorderThickness="1">
            <Image x:Name="QrImage" Width="300" Height="300"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True"/>
        </Border>
        <TextBlock x:Name="HintText" FontSize="12" Foreground="#3C3C43" TextWrapping="Wrap" Margin="0,12,0,0"/>
        <TextBlock x:Name="UriText" FontSize="10" Foreground="#A0A0A5" TextWrapping="Wrap" Margin="0,6,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="复制 otpauth 链接" Click="OnCopy" Padding="12,6" FontSize="12"/>
            <Button Content="关闭" Click="OnClose" Padding="14,6" FontSize="12" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
