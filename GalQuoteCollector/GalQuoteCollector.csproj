<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>Gal-quote-tool</AssemblyName>
    <Version>1.3.6</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app_icon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 插件契约（很小，只有接口）；插件 DLL 本身不引用，运行时从 plugins\ 反射加载 -->
    <ProjectReference Include="..\GalQuoteCollector.Plugins.Abstractions\GalQuoteCollector.Plugins.Abstractions.csproj" />
    <!-- 只为了让 dotnet build/publish 顺带编译插件；不要把它的输出当引用打进主程序 -->
    <ProjectReference Include="..\GalQuoteCollector.Plugins.Qr\GalQuoteCollector.Plugins.Qr.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
      <ExcludeAssets>all</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <!-- 插件（二维码）作为可选文件放进程序目录的 plugins\：单文件版也会在 exe 旁边生成这个目录 -->
  <Target Name="CopyPluginsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <PluginPublishFile Include="$(MSBuildThisFileDirectory)..\GalQuoteCollector.Plugins.Qr\bin\$(Configuration)\net8.0\GalQuoteCollector.Plugins.Qr.dll" />
      <PluginPublishFile Include="$(MSBuildThisFileDirectory)..\GalQuoteCollector.Plugins.Qr\bin\$(Configuration)\net8.0\QRCoder.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginPublishFile)" DestinationFolder="$(PublishDir)plugins"
          SkipUnchangedFiles="true" Condition="Exists('$(PublishDir)')" />
  </Target>

</Project>
